<?xml version="1.0" encoding="utf-8"?>
<!-- Configuration d'artefact SignPath (a recopier dans le projet SignPath).
     La compilation GitHub envoie un zip contenant FirstCut-Setup.exe ; seul ce
     fichier est signe, et seulement si son nom de produit est FirstCut et sa
     version celle de la compilation (parametre "version"). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="FirstCut-Setup.exe" product-name="FirstCut" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
